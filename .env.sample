# Copie para `.env` e preencha. O `.env` esta no `.gitignore`.

# Painel de uso (opcional). Um arquivo local ja guarda historico, sem conta
# nenhuma; para mandar ao Turso, troque a URL e preencha o token. Sem as duas
# linhas o painel roda ao vivo e nao guarda historico.
TURSO_DATABASE_URL=sqlite+pysqlite:///./stats.db
TURSO_AUTH_TOKEN=

# Guardar o TEXTO de cada conversa para a tela de requisicoes. E o dado mais
# sensivel que passa pelo proxy: fica numa tabela separada, o que parece
# credencial vira `[redigido]`, e cada lado e cortado em SHUNT_BODY_LIMIT
# caracteres (64000 por padrao). Vazio ou 0 desliga.
SHUNT_STORE_BODIES=1
SHUNT_BODY_LIMIT=64000

# --- Token do Shunt ---
# Cache de validacao do token, em segundos. Curto de proposito: a revogacao
# num worker diferente do que criou o token vale ate o fim do TTL.
SHUNT_TOKEN_CACHE_TTL=3600