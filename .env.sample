# Copie para `.env` e preencha. O `.env` esta no `.gitignore`.

# llama.cpp local: o valor tem de ser o mesmo que foi passado em
# `llama serve --api-key`.
LOCAL_API_KEY=local

OPENROUTER_API_KEY=sk-or-v1-exemplo
ANTHROPIC_API_KEY=sk-ant-exemplo

# Groq: console.groq.com/keys. Plano gratis, sem cartao.
GROQ_API_KEY=
