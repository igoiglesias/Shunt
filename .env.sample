# Copie para `.env` e preencha. O `.env` esta no `.gitignore`.

# llama.cpp local: o valor tem de ser o mesmo que foi passado em
# `llama serve --api-key`.
LOCAL_API_KEY=local

OPENROUTER_API_KEY=sk-or-v1-exemplo
ANTHROPIC_API_KEY=sk-ant-exemplo

# Groq: console.groq.com/keys. Plano gratis, sem cartao.
GROQ_API_KEY=

# Painel de uso (opcional). Um arquivo local ja guarda historico, sem conta
# nenhuma; para mandar ao Turso, troque a URL e preencha o token. Sem as duas
# linhas o painel roda ao vivo e nao guarda historico.
TURSO_DATABASE_URL=sqlite+pysqlite:///./stats.db
TURSO_AUTH_TOKEN=

# Guardar o TEXTO de cada conversa para a tela de requisicoes. E o dado mais
# sensivel que passa pelo proxy: fica numa tabela separada, o que parece
# credencial vira `[redigido]`, e cada lado e cortado em SHUNT_BODY_LIMIT
# caracteres (64000 por padrao). Vazio ou 0 desliga.
SHUNT_STORE_BODIES=
SHUNT_BODY_LIMIT=

# --- Token do Shunt e credencial do harness ---
# Cache de validacao do token, em segundos. Curto de proposito: a revogacao
# num worker diferente do que criou o token vale ate o fim do TTL.
SHUNT_TOKEN_CACHE_TTL=
# Quanto tempo a credencial do harness fica guardada em memoria, por token e
# destino, antes de voltar a ser lida da configuracao. 43200 = 12 horas.
SHUNT_CLIENT_CREDENTIAL_TTL=

# --- Passagem direta ---
# Teto, em bytes, do corpo que o proxy aceita encaminhar para o host oficial
# de uma rota que ele mesmo nao implementa. 67108864 = 64 MiB.
SHUNT_PASSTHROUGH_BODY_LIMIT=
SHUNT_PASSTHROUGH_TIMEOUT_CONNECT=
SHUNT_PASSTHROUGH_TIMEOUT_READ=
SHUNT_PASSTHROUGH_TIMEOUT_WRITE=
SHUNT_PASSTHROUGH_TIMEOUT_POOL=
